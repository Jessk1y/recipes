# Скопируй в .env и заполни. .env не коммитится.
NODE_ENV=development
PORT=3000

# Строка подключения к PostgreSQL (Neon или локальный Docker)
DATABASE_URL="postgresql://recipes:recipes@localhost:5433/recipes?schema=public"

# Секрет подписи access-токенов (минимум 32 символа). Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Разрешённые источники CORS через запятую
CORS_ORIGINS=http://localhost:8000,https://jessk1y.github.io

# Фото: если задан CLOUDINARY_URL (cloudinary://<api_key>:<api_secret>@<cloud_name>) — хранятся в Cloudinary,
# иначе на локальном диске (server/uploads). В production Cloudinary обязателен.
CLOUDINARY_URL=

# Адрес сайта: на него ведут ссылки из писем (в production обязателен, без слэша в конце)
FRONTEND_URL=http://localhost:8000

# Почта через Brevo (https://app.brevo.com → SMTP & API → API Keys). Без ключа письма печатаются в консоль.
# MAIL_FROM_EMAIL — адрес, подтверждённый в Brevo как отправитель (Senders, Domains & Dedicated IPs → Senders)
BREVO_API_KEY=
# или Mailjet (если задан MAILJET_API_KEY, используется он): ключи — Account Settings → REST API
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Рецепты

# Предложения рецептов: сколько отправок на модерацию разрешено пользователю за 24 часа (по умолчанию 3)
SUBMISSIONS_PER_DAY=3

# Web Push для админа: сгенерировать пару — npm run push:keys (запишет в .env). Те же значения — в Render.
# Без ключей пуши отключены. VAPID_SUBJECT необязателен (mailto: или https), по умолчанию адрес сайта.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Защита от массовых регистраций.
# Капча Cloudflare Turnstile: ключи из панели Cloudflare → Turnstile (нужны оба сразу; без них капча выключена).
# Для локальной разработки подойдут тестовые ключи Cloudflare: сайт 1x00000000000000000000AA, секрет 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Предохранитель: больше стольких регистраций в час на весь сайт — временно 429 и push админам
REGISTRATIONS_PER_HOUR=100
